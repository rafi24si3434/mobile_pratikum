<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    tools:context=".More.MoreFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="#2563EB">

                <!-- Badge -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="PROFILE PORTFOLIO"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:background="#33000000"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"/>

                <!-- Avatar -->
                <LinearLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="-55dp"
                    android:background="@drawable/circle_avatar_bg"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:elevation="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MR"
                        android:textColor="#2563EB"
                        android:textStyle="bold"
                        android:textSize="34sp"/>
                </LinearLayout>

            </FrameLayout>

            <!-- CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingTop="70dp">

                <!-- NAME -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Muhammad Rafi"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:gravity="center"/>

                <!-- STATUS -->
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mahasiswa Sistem Informasi Semester 4"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="24dp"/>

                <!-- ABOUT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#111827"
                    android:padding="18dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ABOUT ME"
                        android:textColor="#60A5FA"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saya adalah mahasiswa Sistem Informasi semester 4 yang memiliki minat besar dalam pengembangan aplikasi, UI/UX Design, dan web development. Saya telah mengerjakan beberapa project kampus menggunakan Laravel dan CodeIgniter."
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="5dp"/>
                </LinearLayout>

                <!-- SKILL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <!-- Laravel -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#1E293B"
                        android:padding="18dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Laravel"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Framework"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- CodeIgniter -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#1E293B"
                        android:padding="18dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CodeIgniter"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Framework"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- EXPERIENCE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#111827"
                    android:padding="18dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROJECT EXPERIENCE"
                        android:textColor="#60A5FA"
                        android:textStyle="bold"
                        android:textSize="11sp"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Design Pengalaman Pengguna (UI/UX)\n• Sistem Informasi Berbasis Web\n• CRUD Application Laravel\n• Website Kampus CodeIgniter\n• Responsive Web Design"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp"/>
                </LinearLayout>

                <!-- CONTACT BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnContact"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="CONTACT ME"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#2563EB"
                    app:cornerRadius="14dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>