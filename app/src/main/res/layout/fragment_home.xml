<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Pertemuan"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="20dp"/>

        <!-- GRID MENU -->
        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="2"
            app:useDefaultMargins="true">

            <!-- Pertemuan 2 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan2"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:text="📖\nPertemuan 2"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:padding="12dp"
                android:backgroundTint="#3908BF"
                app:cornerRadius="20dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <!-- Pertemuan 3 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan3"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:text="💻\nPertemuan 3"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:padding="12dp"
                android:backgroundTint="#4F46E5"
                app:cornerRadius="20dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <!-- Pertemuan 4 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan4"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:text="🚀\nPertemuan 4"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:padding="12dp"
                android:backgroundTint="#2563EB"
                app:cornerRadius="20dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <!-- Pertemuan 5 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan5"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:text="🎯\nPertemuan 5"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:padding="12dp"
                android:backgroundTint="#0EA5E9"
                app:cornerRadius="20dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <!-- Pertemuan 7 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan7"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:text="🏆\nPertemuan 7"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:padding="12dp"
                android:backgroundTint="#7C3AED"
                app:cornerRadius="20dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <!-- Pertemuan 9 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPertemuan9"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:text="🔥\nPertemuan 9"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:padding="12dp"
                android:backgroundTint="#9333EA"
                app:cornerRadius="20dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

        </androidx.gridlayout.widget.GridLayout>

    </LinearLayout>

</ScrollView>