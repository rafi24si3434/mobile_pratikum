<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#2563EB">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦ ABOUT ME"
                    android:textColor="#BFDBFE"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvMessageTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Muhammad Rafi"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="30sp"/>

                <TextView
                    android:id="@+id/tvMessageBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mahasiswa Sistem Informasi Semester 4"
                    android:textColor="#DBEAFE"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MAIN CONTENT -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- FOTO PROFILE -->
                <!-- FOTO PROFILE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginBottom="24dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        app:cardCornerRadius="65dp"
                        app:cardElevation="8dp"
                        app:cardUseCompatPadding="true">

                        <ImageView
                            android:id="@+id/ivMessageIcon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/chatgpt_image_apr_22__2026__04_04_57_pm"
                            android:scaleType="centerCrop" />

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- PROFILE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROFILE"
                    android:textColor="#2563EB"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Saya adalah mahasiswa Sistem Informasi semester 4 yang memiliki minat besar dalam bidang pengembangan aplikasi dan desain antarmuka pengguna. Saya telah mengerjakan beberapa project kampus berbasis web menggunakan framework Laravel dan CodeIgniter."
                    android:textColor="#374151"
                    android:textSize="15sp"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginBottom="18dp"/>

                <!-- SKILL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SKILL  FRAMEWORK"
                    android:textColor="#2563EB"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"/>

                <!-- SKILL BOX -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp"
                        android:background="#2563EB"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Laravel"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Framework"
                            android:textColor="#DBEAFE"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp"
                        android:background="#1D4ED8"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CodeIgniter"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:textSize="18sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Framework"
                            android:textColor="#DBEAFE"
                            android:textSize="11sp"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- PROJECT -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROJECT EXPERIENCE"
                    android:textColor="#2563EB"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Design Pengalaman Pengguna (UI/UX)\n• Sistem Informasi Berbasis Web\n• Aplikasi CRUD Laravel\n• Project Kampus Menggunakan CodeIgniter\n• Pengembangan Tampilan Responsive"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginBottom="20dp"/>

                <!-- BUTTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAction"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="CONTACT ME"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#2563EB"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>